<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniversalRemote.Maui.Remote.Views.EliteRemoteView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.Resources>
        <Style x:Key="EliteKey" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="54" />
            <Setter Property="MinimumWidthRequest" Value="54" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="EliteSection" TargetType="Label">
            <Setter Property="TextColor" Value="#AAB2BB" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.4" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Padding="18,18,18,30" Spacing="18" BackgroundColor="{Binding BackgroundColor}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label Text="ELITE" Style="{StaticResource EliteSection}" TextColor="{Binding AccentColor}" />
                <Label Text="{Binding DisplayName}" TextColor="{Binding TextColor}" FontSize="24" FontAttributes="Bold" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Style="{StaticResource EliteKey}"
                    IsVisible="{Binding HasPower}"
                    WidthRequest="64"
                    HeightRequest="64"
                    CornerRadius="32"
                    Text=""
                    ImageSource="ur_power_light.png"
                    Command="{Binding Power.ExecuteCommand}"
                    BackgroundColor="#D93434"
                    TextColor="White" />
        </Grid>

        <Border IsVisible="{Binding HasFavorites}" Padding="14" Stroke="#30363D" StrokeThickness="1" BackgroundColor="{Binding SurfaceColor}">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding FavoritesTitle}" Style="{StaticResource EliteSection}" />
                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Favorites}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource EliteKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <Border IsVisible="{Binding HasNavigation}" Padding="18" Stroke="#30363D" StrokeThickness="1" BackgroundColor="#11171C">
            <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding NavigationTitle}" Style="{StaticResource EliteSection}" HorizontalTextAlignment="Center" />
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="12" ColumnSpacing="12" MaximumWidthRequest="330" HorizontalOptions="Center">
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource EliteKey}" IsVisible="{Binding HasUp}" Text="▲" Command="{Binding Up.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource EliteKey}" IsVisible="{Binding HasLeft}" Text="◀" Command="{Binding Left.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource EliteKey}" IsVisible="{Binding HasOk}" Text="OK" Command="{Binding Ok.ExecuteCommand}" BackgroundColor="{Binding AccentColor}" TextColor="{Binding OnAccentColor}" CornerRadius="28" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource EliteKey}" IsVisible="{Binding HasRight}" Text="▶" Command="{Binding Right.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource EliteKey}" IsVisible="{Binding HasDown}" Text="▼" Command="{Binding Down.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                </Grid>
                <FlexLayout IsVisible="{Binding HasNavigationExtras}" Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding NavigationExtras}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource EliteKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border IsVisible="{Binding HasAudio}" Padding="12" Stroke="#30363D" StrokeThickness="1" BackgroundColor="{Binding SurfaceColor}">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding VolumeTitle}" Style="{StaticResource EliteSection}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource EliteKey}" IsVisible="{Binding HasVolumeUp}" Text="VOL +" Command="{Binding VolumeUp.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <Button Style="{StaticResource EliteKey}" IsVisible="{Binding HasMute}" Text="{Binding Mute.Label}" ImageSource="{Binding Mute.Icon}" Command="{Binding Mute.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <Button Style="{StaticResource EliteKey}" IsVisible="{Binding HasVolumeDown}" Text="VOL −" Command="{Binding VolumeDown.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" IsVisible="{Binding HasChannel}" Padding="12" Stroke="#30363D" StrokeThickness="1" BackgroundColor="{Binding SurfaceColor}">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ChannelsTitle}" Style="{StaticResource EliteSection}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource EliteKey}" IsVisible="{Binding HasChannelUp}" Text="CH +" Command="{Binding ChannelUp.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    <BoxView HeightRequest="54" Opacity="0" />
                    <Button Style="{StaticResource EliteKey}" IsVisible="{Binding HasChannelDown}" Text="CH −" Command="{Binding ChannelDown.ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <VerticalStackLayout IsVisible="{Binding HasMedia}" Spacing="8">
            <Label Text="{Binding MediaTitle}" Style="{StaticResource EliteSection}" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Media}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource EliteKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding HasExtras}" Spacing="8">
            <Label Text="{Binding MoreControlsTitle}" Style="{StaticResource EliteSection}" />
            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Extras}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource EliteKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="#252B31" TextColor="#F4F6F8" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
