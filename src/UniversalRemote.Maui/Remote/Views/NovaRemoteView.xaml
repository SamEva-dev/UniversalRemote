<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UniversalRemote.Maui.Remote.Views.NovaRemoteView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.Resources>
        <Style x:Key="NovaKey" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="54" />
            <Setter Property="MinimumWidthRequest" Value="54" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="NovaSectionTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#101A2A" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Padding="18,18,18,28" Spacing="16" BackgroundColor="{Binding BackgroundColor}">
        <Border Padding="16" StrokeThickness="0" BackgroundColor="{Binding SurfaceColor}">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="NOVA" FontAttributes="Bold" FontSize="11" TextColor="{Binding AccentColor}" />
                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="24" TextColor="{Binding TextColor}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Style="{StaticResource NovaKey}"
                        IsVisible="{Binding HasPower}"
                        Text="{Binding Power.Label}"
                        ImageSource="{Binding Power.Icon}"
                        Command="{Binding Power.ExecuteCommand}"
                        BackgroundColor="{Binding AccentColor}"
                        TextColor="{Binding OnAccentColor}"
                        CornerRadius="30" />
            </Grid>
        </Border>

        <Border IsVisible="{Binding HasFavorites}" Padding="14" StrokeThickness="0" BackgroundColor="{Binding SurfaceColor}">
            <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding FavoritesTitle}" Style="{StaticResource NovaSectionTitle}" />
                <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Favorites}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NovaKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout IsVisible="{Binding HasQuickActions}" Spacing="8">
            <Label Text="{Binding ShortcutsTitle}" Style="{StaticResource NovaSectionTitle}" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding QuickActions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NovaKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <Border IsVisible="{Binding HasNavigation}" Padding="16" StrokeThickness="0" BackgroundColor="{Binding SurfaceColor}">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding NavigationTitle}" Style="{StaticResource NovaSectionTitle}" HorizontalTextAlignment="Center" />
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10" MaximumWidthRequest="340" HorizontalOptions="Center">
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource NovaKey}" IsVisible="{Binding HasUp}" Text="▲" Command="{Binding Up.ExecuteCommand}" BackgroundColor="{Binding Up.BackgroundColor}" TextColor="{Binding Up.TextColor}" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource NovaKey}" IsVisible="{Binding HasLeft}" Text="◀" Command="{Binding Left.ExecuteCommand}" BackgroundColor="{Binding Left.BackgroundColor}" TextColor="{Binding Left.TextColor}" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaKey}" IsVisible="{Binding HasOk}" Text="OK" Command="{Binding Ok.ExecuteCommand}" BackgroundColor="{Binding AccentColor}" TextColor="{Binding OnAccentColor}" CornerRadius="30" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource NovaKey}" IsVisible="{Binding HasRight}" Text="▶" Command="{Binding Right.ExecuteCommand}" BackgroundColor="{Binding Right.BackgroundColor}" TextColor="{Binding Right.TextColor}" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource NovaKey}" IsVisible="{Binding HasDown}" Text="▼" Command="{Binding Down.ExecuteCommand}" BackgroundColor="{Binding Down.BackgroundColor}" TextColor="{Binding Down.TextColor}" />
                </Grid>
                <FlexLayout IsVisible="{Binding HasNavigationExtras}" Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding NavigationExtras}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NovaKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border IsVisible="{Binding HasAudio}" Padding="12" StrokeThickness="0" BackgroundColor="{Binding SurfaceColor}">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding VolumeTitle}" Style="{StaticResource NovaSectionTitle}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource NovaKey}" IsVisible="{Binding HasVolumeUp}" Text="+" FontSize="22" Command="{Binding VolumeUp.ExecuteCommand}" BackgroundColor="{Binding VolumeUp.BackgroundColor}" TextColor="{Binding VolumeUp.TextColor}" />
                    <Button Style="{StaticResource NovaKey}" IsVisible="{Binding HasMute}" Text="{Binding Mute.Label}" ImageSource="{Binding Mute.Icon}" Command="{Binding Mute.ExecuteCommand}" BackgroundColor="{Binding Mute.BackgroundColor}" TextColor="{Binding Mute.TextColor}" />
                    <Button Style="{StaticResource NovaKey}" IsVisible="{Binding HasVolumeDown}" Text="−" FontSize="22" Command="{Binding VolumeDown.ExecuteCommand}" BackgroundColor="{Binding VolumeDown.BackgroundColor}" TextColor="{Binding VolumeDown.TextColor}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" IsVisible="{Binding HasChannel}" Padding="12" StrokeThickness="0" BackgroundColor="{Binding SurfaceColor}">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ChannelsTitle}" Style="{StaticResource NovaSectionTitle}" HorizontalTextAlignment="Center" />
                    <Button Style="{StaticResource NovaKey}" IsVisible="{Binding HasChannelUp}" Text="+" FontSize="22" Command="{Binding ChannelUp.ExecuteCommand}" BackgroundColor="{Binding ChannelUp.BackgroundColor}" TextColor="{Binding ChannelUp.TextColor}" />
                    <BoxView HeightRequest="54" Opacity="0" />
                    <Button Style="{StaticResource NovaKey}" IsVisible="{Binding HasChannelDown}" Text="−" FontSize="22" Command="{Binding ChannelDown.ExecuteCommand}" BackgroundColor="{Binding ChannelDown.BackgroundColor}" TextColor="{Binding ChannelDown.TextColor}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <VerticalStackLayout IsVisible="{Binding HasMedia}" Spacing="8">
            <Label Text="{Binding MediaTitle}" Style="{StaticResource NovaSectionTitle}" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Media}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NovaKey}" Text="{Binding Label}" ImageSource="{Binding Icon}" Command="{Binding ExecuteCommand}" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding HasExtras}" Spacing="8">
            <Label Text="{Binding MoreControlsTitle}" Style="{StaticResource NovaSectionTitle}" />
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Extras}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NovaKey}" Text="{Binding Label}" Command="{Binding ExecuteCommand}" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
