<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversalRemote.Maui.Discovery.DeviceSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Finaliser l’appareil">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="18" MaximumWidthRequest="620" HorizontalOptions="Center">
            <Border Padding="18" Stroke="#2D8B57" StrokeThickness="1" BackgroundColor="#102A20" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="6">
                    <Label Text="✓  Association réussie" FontSize="20" FontAttributes="Bold" TextColor="#78E6A8" />
                    <Label Text="La connexion avec la TV est enregistrée. Donnez-lui maintenant un nom et une pièce, puis UniversalRemote ouvrira directement sa télécommande." FontSize="13" TextColor="#D8E9DF" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Nom de l’appareil" FontAttributes="Bold" />
                <Entry x:Name="nameEntry" Placeholder="Ex. TV TCL Salon" MaxLength="200" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Pièce" FontAttributes="Bold" />
                <Picker x:Name="roomPicker" Title="Choisir une pièce" />
                <Entry x:Name="newRoomEntry" Placeholder="Ex. Salon, Chambre…" MaxLength="60" IsVisible="False" />
                <Label Text="Vous pourrez modifier la pièce plus tard depuis l’écran Pièces." FontSize="11" Opacity="0.72" />
            </VerticalStackLayout>

            <Button x:Name="saveButton" Text="Enregistrer et ouvrir la télécommande" MinimumHeightRequest="54" />
            <Button x:Name="skipButton" Text="Ouvrir sans choisir de pièce" MinimumHeightRequest="48" />
            <Label x:Name="statusLabel" HorizontalTextAlignment="Center" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
