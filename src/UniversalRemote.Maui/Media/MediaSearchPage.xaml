<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversalRemote.Maui.Media.MediaSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Recherche Media"
    BackgroundColor="{StaticResource MediaHorizonBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="18,16,18,24" RowSpacing="14" MaximumWidthRequest="1040" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="3">
            <Label Text="RECHERCHE UNIFIÉE" Style="{StaticResource MediaHorizonEyebrow}" />
            <Label Text="Trouver un contenu" Style="{StaticResource MediaHorizonPageTitle}" />
            <Label Text="Chaînes, films, séries et catégories de toutes vos sources." Style="{StaticResource MediaHorizonMutedText}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource MediaHorizonCard}" Padding="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar
                    x:Name="searchBar"
                    Placeholder="Chaîne, film, série, catégorie…"
                    Style="{StaticResource MediaHorizonSearch}"
                    AutomationProperties.Name="Recherche Media" />
                <Button x:Name="searchButton" Grid.Column="1" Text="Rechercher" Style="{StaticResource MediaHorizonPrimaryButton}" />
            </Grid>
        </Border>

        <CollectionView x:Name="resultsList" Grid.Row="2" SelectionMode="Single">
            <CollectionView.EmptyView>
                <Border Style="{StaticResource MediaHorizonCard}" Margin="0,8,0,0" Padding="30">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⌕" TextColor="{StaticResource MediaHorizonAccent}" FontSize="32" HorizontalTextAlignment="Center" />
                        <Label x:Name="emptyLabel" Text="Saisissez au moins 2 caractères." Style="{StaticResource MediaHorizonMutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Style="{StaticResource MediaHorizonCard}" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#16304A" Stroke="#2F5D83" StrokeShape="RoundRectangle 13">
                                <Label Text="⌕" TextColor="{StaticResource MediaHorizonAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" TextColor="{StaticResource MediaHorizonText}" FontAttributes="Bold" MaxLines="2" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MediaHorizonSubtleText}" MaxLines="2" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource MediaHorizonAccent}" FontSize="24" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
