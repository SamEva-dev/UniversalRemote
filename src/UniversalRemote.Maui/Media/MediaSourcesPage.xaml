<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversalRemote.Maui.Media.MediaSourcesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sources Media"
    BackgroundColor="{StaticResource MediaHorizonBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,30" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Sources Media" Style="{StaticResource MediaHorizonPageTitle}" />
                    <Label Text="Ajoutez votre propre abonnement ou playlist autorisée." Style="{StaticResource MediaHorizonSubtleText}" />
                </VerticalStackLayout>
                <Button x:Name="refreshButton" Grid.Column="1" Text="↻" Style="{StaticResource MediaHorizonIconButton}" />
            </Grid>

            <Border Style="{StaticResource MediaHorizonRaisedCard}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Ajouter une source" Style="{StaticResource MediaHorizonSectionTitle}" />

                    <Label Text="Type de connexion" Style="{StaticResource MediaHorizonSubtleText}" />
                    <Picker x:Name="typePicker" Title="Choisir un type" TextColor="{StaticResource MediaHorizonText}" />

                    <Label Text="Nom" Style="{StaticResource MediaHorizonSubtleText}" />
                    <Entry x:Name="nameEntry" Placeholder="Ex. Mon abonnement TV" MaxLength="100" TextColor="{StaticResource MediaHorizonText}" PlaceholderColor="#8294AA" />

                    <VerticalStackLayout x:Name="xtreamFields" Spacing="8">
                        <Label Text="DNS / URL du serveur" Style="{StaticResource MediaHorizonSubtleText}" />
                        <Entry x:Name="serverEntry" Placeholder="http://serveur.exemple.com:8080" Keyboard="Url" TextColor="{StaticResource MediaHorizonText}" PlaceholderColor="#8294AA" />
                        <Label Text="Utilisez l’adresse exacte fournie par votre service (http/https et port inclus). Si vous saisissez seulement le DNS, UniversalRemote utilisera HTTP par défaut." Style="{StaticResource MediaHorizonMutedText}" FontSize="11" />
                        <Label Text="Nom d’utilisateur" Style="{StaticResource MediaHorizonSubtleText}" />
                        <Entry x:Name="usernameEntry" Placeholder="Username" TextColor="{StaticResource MediaHorizonText}" PlaceholderColor="#8294AA" />
                        <Label Text="Mot de passe" Style="{StaticResource MediaHorizonSubtleText}" />
                        <Entry x:Name="passwordEntry" Placeholder="Password" IsPassword="True" TextColor="{StaticResource MediaHorizonText}" PlaceholderColor="#8294AA" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="m3uFields" Spacing="8" IsVisible="False">
                        <Label Text="URL M3U / M3U8" Style="{StaticResource MediaHorizonSubtleText}" />
                        <Entry x:Name="playlistEntry" Placeholder="https://…/playlist.m3u" Keyboard="Url" TextColor="{StaticResource MediaHorizonText}" PlaceholderColor="#8294AA" />
                    </VerticalStackLayout>

                    <Label Text="Les identifiants et URLs sensibles sont enregistrés dans le stockage sécurisé du téléphone et ne sont pas écrits dans les logs." Style="{StaticResource MediaHorizonMutedText}" FontSize="11" />
                    <Button x:Name="saveButton" Text="Tester et enregistrer" Style="{StaticResource MediaHorizonPrimaryButton}" MinimumHeightRequest="54" />
                    <Label x:Name="statusLabel" Text="" Style="{StaticResource MediaHorizonSubtleText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Sources configurées" Style="{StaticResource MediaHorizonSectionTitle}" />
                <CollectionView x:Name="sourceList" SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource MediaHorizonCard}" Padding="16">
                            <Label Text="Aucune source configurée." Style="{StaticResource MediaHorizonMutedText}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MediaHorizonCard}" Margin="0,0,0,8" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Name}" TextColor="{StaticResource MediaHorizonText}" FontAttributes="Bold" />
                                        <Label Text="{Binding TypeLabel}" Style="{StaticResource MediaHorizonSubtleText}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="●" TextColor="#5AD98B" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button x:Name="deleteButton" Text="Supprimer la source sélectionnée" Style="{StaticResource MediaHorizonGhostButton}" IsEnabled="False" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
