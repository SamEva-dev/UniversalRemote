<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniversalRemote.Maui.Media.MediaCatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource MediaHorizonBackground}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="18,16,18,24" RowSpacing="14" MaximumWidthRequest="1180" HorizontalOptions="Center">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="titleLabel" Text="Catalogue" Style="{StaticResource MediaHorizonPageTitle}" />
                <Label x:Name="subtitleLabel" Text="Catalogue normalisé" Style="{StaticResource MediaHorizonMutedText}" />
            </VerticalStackLayout>
            <Button
                x:Name="refreshButton"
                Grid.Column="1"
                Text="↻"
                Style="{StaticResource MediaHorizonIconButton}"
                FontSize="20"
                VerticalOptions="Center"
                AutomationProperties.Name="Actualiser le catalogue" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MediaHorizonCard}" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border WidthRequest="30" HeightRequest="30" BackgroundColor="#16304A" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Label Text="●" TextColor="{StaticResource MediaHorizonSuccess}" FontSize="10" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label x:Name="statusLabel" Grid.Column="1" Text="Chargement…" Style="{StaticResource MediaHorizonMutedText}" VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <CollectionView x:Name="catalogList" Grid.Row="2" SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="catalogLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Style="{StaticResource MediaHorizonCard}" Margin="0,12,0,0" Padding="28">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⌁" TextColor="{StaticResource MediaHorizonAccent}" FontSize="30" HorizontalTextAlignment="Center" />
                        <Label x:Name="emptyTitleLabel" Text="Aucun contenu" Style="{StaticResource MediaHorizonSectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Vérifiez vos sources Media puis actualisez." Style="{StaticResource MediaHorizonMutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MediaHorizonCard}" Padding="0" MinimumHeightRequest="118">
                        <Grid RowDefinitions="96,Auto" BackgroundColor="Transparent">
                            <Grid>
                                <Image Source="{Binding Artwork}" Aspect="AspectFill" IsVisible="{Binding HasArtwork}" />
                                <Border
                                    Margin="10"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    BackgroundColor="#D8122033"
                                    Stroke="#42688B"
                                    StrokeShape="RoundRectangle 13">
                                    <Label Text="{Binding Initial}" TextColor="{StaticResource MediaHorizonCyan}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Border Margin="10" HorizontalOptions="End" VerticalOptions="End" Style="{StaticResource MediaHorizonChip}">
                                    <Label Text="{Binding KindText}" TextColor="{StaticResource MediaHorizonText}" FontSize="9" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" Padding="13,11,13,13" Spacing="5">
                                <Label Text="{Binding Title}" TextColor="{StaticResource MediaHorizonText}" FontAttributes="Bold" MaxLines="2" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MediaHorizonSubtleText}" MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
