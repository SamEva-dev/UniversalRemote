<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="UniversalRemote.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>UniversalRemote.Hub.Ble</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Bluetooth Low Energy discovery, connection and transport for UniversalRemote external infrared hubs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UniversalRemote.Abstractions/UniversalRemote.Abstractions.csproj" />
    <ProjectReference Include="../UniversalRemote.Hub/UniversalRemote.Hub.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
