<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
    <RootNamespace>UniversalRemote.Remote.Application</RootNamespace>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Description>UniversalRemote Application preview SDK.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../UniversalRemote.Core/UniversalRemote.Core.csproj" />
		<ProjectReference Include="..\UniversalRemote.Discovery\UniversalRemote.Discovery.csproj" />
		<ProjectReference Include="..\UniversalRemote.Presentation\UniversalRemote.Presentation.csproj" />
		<PackageReference Include="DomainRelay.DependencyInjection" Version="3.1.3" />
		<PackageReference Include="DomainRelay.Diagnostics" Version="3.1.3" />
		<PackageReference Include="DomainRelay.Mapping.DependencyInjection" Version="3.1.3" />
		<PackageReference Include="DomainRelay.Validation" Version="3.1.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<None Include="../../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>