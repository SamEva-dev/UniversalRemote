<Project>
  <PropertyGroup>
    <!-- Repository-wide defaults. MAUI clears TargetFramework and declares TargetFrameworks itself. -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- One source of truth for UniversalRemote package versions. -->
    <UniversalRemoteVersion>0.8.0-preview.3</UniversalRemoteVersion>
    <Version>$(UniversalRemoteVersion)</Version>
    <PackageVersion>$(UniversalRemoteVersion)</PackageVersion>

    <!-- Used by UniversalRemote.Maui.csproj. -->
    <MauiVersion>10.0.0</MauiVersion>
  </PropertyGroup>
</Project>
